# Copy to .env and fill in. Never commit .env.
# Public base URL of this server (no trailing slash). Used as the OAuth
# issuer and in all metadata / redirect URLs.
PUBLIC_URL=https://mcp.gymsuit.app
# GymSuit backend API.
GYMSUIT_API_BASE=https://api.gymsuit.app
# Long random secret: encrypts stored GymSuit tokens and signs web sessions.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET_KEY=
# SQLite file for OAuth clients, tokens and linked GymSuit users.
DATABASE_PATH=data/gymsuit-mcp.db
HOST=0.0.0.0
PORT=8000
# Optional: comma-separated hosts allowed to reach /mcp (DNS-rebinding
# protection). Defaults to the PUBLIC_URL host.
MCP_ALLOWED_HOSTS=
